# Llave del Reto Agente (se genera en tu panel, empieza por pk_)
RETO_API_KEY=
RETO_BASE_URL=https://api.reto.pltk.mx/v1
RETO_MODEL=grok-4.7

# Token de Datos Abiertos Colombia (opcional, mejora el límite de consultas)
DATOS_ABIERTOS_APP_TOKEN=

# Perfil de la pyme que el agente usa para filtrar
PERFIL_PATH=config/perfil.example.json

# Máximo de pasos del agente por ejecución (tope de seguridad contra bucles)
MAX_PASOS=25